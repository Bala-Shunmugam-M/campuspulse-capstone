# ==========================================================================
# CampusPulse - Environment Configuration TEMPLATE
# --------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
#     Windows : copy .env.example .env
#     macOS   : cp .env.example .env
#
# `.env` is listed in .gitignore and MUST NEVER be committed.
# ==========================================================================

# --- Supabase / PostgreSQL connection -------------------------------------
# Find these under: Supabase Dashboard -> Project Settings -> Database
DB_HOST=db.YOUR_PROJECT_REF.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password-here

# TLS is mandatory for Supabase. Leave as `require` unless you know otherwise.
DB_SSLMODE=require

# --- Optional: Session Pooler fallback ------------------------------------
# Supabase direct connections (db.*.supabase.co) are IPv6-only on newer
# projects. If your network is IPv4-only, the direct host will fail to
# resolve. Fill these in from Dashboard -> Database -> Connection Pooling
# (Session mode) and the scripts will fall back to them automatically.
# Find these under the green "Connect" button in the Supabase dashboard,
# under "Session pooler". They look like this:
#   POOLER_HOST=aws-0-<region>.pooler.supabase.com   <- note: IPv4-reachable
#   POOLER_USER=postgres.<your-project-ref>          <- NOT plain 'postgres'
#   POOLER_PORT=5432 for Session mode, 6543 for Transaction mode
# The scripts try the direct host first and only fall back to these, so on a
# known IPv4-only network set DB_HOST to the pooler too and skip the wait.
POOLER_HOST=
POOLER_PORT=5432
POOLER_USER=

# --- Application schema ---------------------------------------------------
# All CampusPulse objects are created inside this schema so that they never
# collide with Supabase's own `public` / `auth` / `storage` schemas.
DB_SCHEMA=campuspulse

# --- Synthetic data generation knobs --------------------------------------
# Controls 02_Insert_Data.py. Presets: small | medium | large
DATA_SCALE=medium

# Fixed seed => reproducible datasets. Change it to generate a different world.
RANDOM_SEED=42

# How many months of historical activity to simulate.
HISTORY_MONTHS=18
